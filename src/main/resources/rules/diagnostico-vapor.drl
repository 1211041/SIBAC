                        "Indica limitação operacional na rede de distribuição de vapor. " +
                        "Ação: verificar consumo real dos processos, balanços de vapor " +
                        "e possíveis purgas excessivas na linha.");
        $d.addRegraAtivada("V-3.5",
                "P↓ T Normal C↓ com todos os checks OK → limitação operacional na distribuição.");
        update($d);
end

// ── Grupo 4 fallback ─────────────────────────────────────────

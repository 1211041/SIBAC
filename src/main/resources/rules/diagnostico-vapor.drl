        $d.setConclusao("Acumulação de pressão por válvula(s) de saída de vapor parcialmente fechada(s). " +
                        "Ação: verificar e abrir totalmente as válvulas de saída.");
        $d.addRegraAtivada("V-8.2",
                "P↑ T Normal com válvulas de saída não totalmente abertas → restrição de saída.");
        update($d);
end

rule "V-8.3 — Acumulação de Pressão por Falha no Controlo de Pressão"
    salience 80
    when
        $v : SistemaVapor(pressao == "Alta", temperatura == "Normal",
                          controloPressaoAtuaCorretamente == "Nao")
        $d : Diagnostico(problema == null)
    then
        $d.setTipoAnomalia("Anomalia na Produção de Vapor");
        $d.setProblema("AcumulacaoPressaoPorFalhaControlo");
        $d.setEstadoDiagnostico("Concluido");
        $d.setConclusao("Acumulação de pressão causada por falha no sistema de controlo de pressão. " +
                        "Ação: verificar controlador de pressão, válvula de controlo e setpoint.");
        $d.addRegraAtivada("V-8.3",
                "P↑ T Normal com controlo de pressão com falha → acumulação por perda de regulação.");
        update($d);
end

rule "V-8.4 — Erro no Sensor de Pressão (P↑ T Normal)"
    salience 60
    when
        $v : SistemaVapor(pressao == "Alta", temperatura == "Normal",
                          sensorPressaoCorreto == "Nao")
        $d : Diagnostico(problema == null)
    then

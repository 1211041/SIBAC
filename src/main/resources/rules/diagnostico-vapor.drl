    salience 45
    when
        $v : SistemaVapor(pressao == "Baixa", temperatura == "Normal", caudal == "Baixo",
                          medidorCaudalCorreto == "Sim",
                          valvulasVaporTotalmenteAbertas == "Sim",
                          restricaoLinhaVapor == "Nao",

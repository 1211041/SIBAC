package rules;

import pt.isep.sbc.model.SistemaVapor;
import pt.isep.sbc.model.SistemaCombustao;
import pt.isep.sbc.model.Diagnostico;

rule "Regra 1 - Producao Insuficiente Por Combustao"
    when
        $v : SistemaVapor(pressao == "Baixa", temperatura == "Baixa", caudal == "Baixo")
        $c : SistemaCombustao(combustaoNormal == "Nao")
        $d : Diagnostico(problema == null)
    then
        $d.setTipoAnomalia("Anomalia na Produção de Vapor");
        $d.setProblema("ProducaoInsuficientePorCombustao");
        $d.setConclusao("A produção de vapor está insuficiente devido a uma falha detectada no sistema de combustão (combustão anormal).");
        $d.addRegraAtivada("Regra 1", "Pressão, temperatura e caudal baixos no sistema de vapor, associados a uma combustão não normal.");
        update($d);
end

rule "Regra 2 - Producao Insuficiente Por Turbina"
    when
        $v : SistemaVapor(pressao == "Baixa", temperatura == "Baixa", caudal == "Baixo", turbinaForneceCalorSuficiente == "Nao")
        $c : SistemaCombustao(combustaoNormal == "Sim")
        $d : Diagnostico(problema == null)
    then
        $d.setTipoAnomalia("Anomalia na Produção de Vapor");
        $d.setProblema("ProducaoInsuficientePorTurbina");
        $d.setConclusao("A produção de vapor está insuficiente devido a calor insuficiente fornecido pela turbina, apesar de a combustão estar normal.");
        $d.addRegraAtivada("Regra 2", "Pressão, temperatura e caudal baixos no sistema de vapor, com combustão normal, mas sem calor suficiente fornecido pela turbina.");
        update($d);
end

rule "Regra 6 - Sobreaquecimento Vapor"
    when
        $v : SistemaVapor(pressao == "Alta", temperatura == "Alta")
        $d : Diagnostico(problema == null)
    then
        $d.setTipoAnomalia("Anomalia na Produção de Vapor");
        $d.setProblema("SobreaquecimentoVapor");
        $d.setConclusao("Sobreaquecimento do vapor detetado devido a pressão e temperatura excessivamente elevadas na caldeira.");
        $d.addRegraAtivada("Regra 6", "Pressão e temperatura altas no sistema de vapor, indicando sobreaquecimento (pressão excessiva).");
        update($d);
end

rule "Regra 7 - Caudal Vapor Anormal"
    when
        $v : SistemaVapor(caudal == "Alto", pressao == "Normal", temperatura == "Normal")
        $d : Diagnostico(problema == null)
    then
        $d.setTipoAnomalia("Anomalia na Produção de Vapor");
        $d.setProblema("CaudalVaporAnormal");
        $d.setConclusao("Caudal de vapor anormalmente elevado com pressão e temperatura normais, indicando possível anomalia no controlo de caudal.");
        $d.addRegraAtivada("Regra 7", "Caudal alto no sistema de vapor com pressão e temperatura normais, sugerindo caudal excessivo.");
        update($d);
end

rule "Regra 8 - Queda Brusca Pressao Vapor"
    when
        $v : SistemaVapor(pressao == "Baixa", temperatura == "Normal", caudal == "Normal", turbinaForneceCalorSuficiente == "Sim")
        $c : SistemaCombustao(combustaoNormal == "Sim")
        $d : Diagnostico(problema == null)
    then
        $d.setTipoAnomalia("Anomalia na Produção de Vapor");
        $d.setProblema("QuedaPressaoVapor");
        $d.setConclusao("Queda brusca de pressão de vapor com temperatura, caudal e combustão normais, sugerindo possível fuga no sistema.");
        $d.addRegraAtivada("Regra 8", "Pressão baixa no sistema de vapor com temperatura e caudal normais, combustão normal e calor da turbina suficiente, indicando possível fuga.");
        update($d);
end

        $d.setConclusao("Temperatura do vapor excessiva causada por falha no dessobreaquecedor (sem arrefecimento). " +
                        "Ação: verificar válvula de injeção de água, controlador de temperatura e bomba de dessobreaquecimento.");
        $d.addRegraAtivada("V-9.1",
                "P Normal T↑ C Normal com dessobreaquecedor com falha → sobreaquecimento por perda de arrefecimento.");
        update($d);
end

rule "V-9.2 — Sobreaquecimento por Excesso Térmico da Combustão"
    salience 85
    when
        $v : SistemaVapor(pressao == "Normal", temperatura == "Alta", caudal == "Normal",
                          combustaoNormal == "Nao")
        $d : Diagnostico(problema == null)
    then
        $d.setTipoAnomalia("Anomalia na Produção de Vapor");
        $d.setProblema("TemperaturaAltaPorExcessoTermicoCombustao");
        $d.setEstadoDiagnostico("Concluido");
        $d.setConclusao("Temperatura do vapor excessiva causada por excesso térmico do sistema de combustão. " +
                        "Ação: reduzir carga de combustão e verificar o sistema de controlo de temperatura.");
        $d.addRegraAtivada("V-9.2",
                "P Normal T↑ C Normal com combustão anormal → sobreaquecimento por excesso de calor.");
        update($d);
end

rule "V-9.3 — Sobreaquecimento por Alta Carga Térmica da Turbina"
    salience 80
    when
        $v : SistemaVapor(pressao == "Normal", temperatura == "Alta", caudal == "Normal",
                          turbinaForneceCalorSuficiente == "Sim",
                          dessobreaquecedorAtuaCorretamente == "Sim",
                          combustaoNormal == "Sim")
        $d : Diagnostico(problema == null)
    then
        $d.setTipoAnomalia("Anomalia na Produção de Vapor");
        $d.setProblema("TemperaturaAltaPorAltaCargaTurbina");
        $d.setEstadoDiagnostico("Concluido");
        $d.setConclusao("Temperatura excessiva sem falhas identificadas nos sistemas de controlo. " +
                        "Possível sobrecarga térmica proveniente dos gases de escape da turbina. " +
                        "Ação: verificar temperatura de escape da turbina e condições operacionais da caldeira de recuperação.");
        $d.addRegraAtivada("V-9.3",
                "P Normal T↑ C Normal com todos os sistemas OK → sobrecarga térmica da turbina.");
        update($d);
end

rule "V-9.4 — Erro no Sensor de Temperatura (P Normal T↑ C Normal)"
    salience 60
    when
        $v : SistemaVapor(pressao == "Normal", temperatura == "Alta", caudal == "Normal",
                          sensorTemperaturaCorreto == "Nao")
        $d : Diagnostico(problema == null)
    then
        $d.setTipoAnomalia("Anomalia na Produção de Vapor");
        $d.setProblema("ErroInstrumentacaoTemperatura");
        $d.setEstadoDiagnostico("Concluido");
        $d.setConclusao("Leitura de temperatura alta com pressão e caudal normais. Possível falha no sensor de temperatura. " +
                        "Ação: verificar termopar/RTD, comparar com medição local ou sonda de reserva.");
        $d.addRegraAtivada("V-9.4",
                "P Normal T↑ C Normal com sensor de temperatura com falha → possível leitura falsa.");
        update($d);
end


// ════════════════════════════════════════════════════════════
//  GRUPO 10 — Situação contraditória / não classificada
// ════════════════════════════════════════════════════════════

rule "V-10.1 — Situação Contraditória por Sensores Incoerentes"
    salience 50
    when
        $v : SistemaVapor(sensoresCoerentes == "Nao", mudancaOperacionalRecente == "Nao")
        $d : Diagnostico(problema == null)
    then
        $d.setTipoAnomalia("Anomalia na Produção de Vapor");
        $d.setProblema("ErroInstrumentacao");
        $d.setEstadoDiagnostico("Concluido");
        $d.setConclusao("Leituras de sensores incoerentes entre si sem alterações operacionais recentes. " +
                        "Ação: verificar todos os instrumentos de pressão, temperatura e caudal. " +
                        "Comparar com leituras locais e substituir instrumentação suspeita.");
        $d.addRegraAtivada("V-10.1",
                "Sensores incoerentes sem alteração operacional recente → falha de instrumentação.");
        update($d);
end

rule "V-10.2 — Situação Contraditória por Mudança Operacional"
    salience 50
    when
        $v : SistemaVapor(sensoresCoerentes == "Nao", mudancaOperacionalRecente == "Sim")
        $d : Diagnostico(problema == null)
    then
        $d.setTipoAnomalia("Anomalia na Produção de Vapor");
        $d.setProblema("AlteracaoOperacional");
        $d.setEstadoDiagnostico("Concluido");
        $d.setConclusao("Leituras contraditórias associadas a uma mudança operacional recente. " +
                        "Ação: rever as alterações efetuadas, aguardar estabilização do processo " +
                        "e confirmar se os parâmetros convergem para valores nominais.");
        $d.addRegraAtivada("V-10.2",
                "Sensores incoerentes com mudança operacional recente → instabilidade transitória.");
        update($d);
end


// ════════════════════════════════════════════════════════════
//  REGRAS DE FALLBACK — Caminhos que chegam ao fim da árvore
//  sem causa identificada automaticamente (requerem verificação
//  manual) ou com causa implícita pelos dados agregados.
//
//  Correspondem aos nós terminais do diagrama de fluxo do
//  relatório que não tinham regra DRL correspondente.
// ════════════════════════════════════════════════════════════

// ── Grupo 1 fallback ─────────────────────────────────────────
rule "V-1.6 — Produção Insuficiente Sem Causa Evidente"
    salience 45
    when
        $v : SistemaVapor(pressao == "Baixa", temperatura == "Baixa", caudal == "Baixo",
                          combustaoNormal == "Sim",
                          turbinaForneceCalorSuficiente == "Sim",
                          alimentacaoBFWCorreta == "Sim",
                          nivelBarrileteDentroLimites == "Sim",
                          sistemaControloAtuaCorretamente == "Sim")
        $d : Diagnostico(problema == null)
    then
        $d.setTipoAnomalia("Anomalia na Produção de Vapor");
        $d.setProblema("ProducaoInsuficienteSemCausaEvidente");
        $d.setEstadoDiagnostico("Concluido");
        $d.setConclusao("Produção de vapor insuficiente sem causa identificada automaticamente. " +
                        "Todos os subsistemas reportam funcionamento normal. " +
                        "Necessita verificação manual pelo técnico especialista: " +
                        "inspecionar tubagem da caldeira, depósitos de incrustações e eficiência das superfícies de troca.");
        $d.addRegraAtivada("V-1.6",
                "P↓ T↓ C↓ com todos os subsistemas OK → causa não identificada, verificação manual.");
        update($d);
end

// ── Grupo 2 fallback ─────────────────────────────────────────
rule "V-2.5 — Perda de Eficiência Térmica na Caldeira"
    salience 45
    when
        $v : SistemaVapor(pressao == "Baixa", temperatura == "Baixa", caudal == "Normal",
                          sensoresCoerentes == "Sim",
                          combustaoNormal == "Sim",
                          turbinaForneceCalorSuficiente == "Sim",
                          dessobreaquecedorAbertoEmExcesso == "Nao")
        $d : Diagnostico(problema == null)
    then
        $d.setTipoAnomalia("Anomalia na Produção de Vapor");
        $d.setProblema("PerdaEficienciaTermicaCaldeira");
        $d.setEstadoDiagnostico("Concluido");
        $d.setConclusao("Baixa pressão e temperatura com caudal normal e dessobreaquecedor OK. " +
                        "Indica perda de eficiência da troca térmica na caldeira. " +
                        "Ação: inspecionar superfícies de aquecimento, verificar incrustações " +
                        "e realizar limpeza de tubagem.");
        $d.addRegraAtivada("V-2.5",
                "P↓ T↓ C Normal, combustão e turbina OK, dessobreaquecedor não em excesso → perda de eficiência térmica.");
        update($d);
end

// ── Grupo 3 fallback ─────────────────────────────────────────

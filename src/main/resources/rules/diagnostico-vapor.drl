package rules;

import pt.isep.sbc.model.SistemaVapor;
import pt.isep.sbc.model.Diagnostico;

/*
 * ============================================================
 *  SIBAC — Base de Conhecimento: Diagnóstico da Produção de Vapor
 * ============================================================
 *
 *  Organização das regras (por combinação de P/T/C):
 *
 *  GRUPO 1 — P↓ T↓ C↓  (produção global insuficiente)
 *  GRUPO 2 — P↓ T↓ C Normal (energia térmica insuficiente)
 *  GRUPO 3 — P↓ T Normal C↓ (restrição ou produção parcial)
 *  GRUPO 4 — P↓ T Normal C Normal (perda de pressão)
 *  GRUPO 5 — P Normal T↓ C Normal (problema térmico localizado)
 *  GRUPO 6 — P Normal T Normal C↓ (caudal insuficiente)
 *  GRUPO 7 — P↑ T↑ (produção excessiva / sobreaquecimento)
 *  GRUPO 8 — P↑ T Normal (acumulação de pressão)
 *  GRUPO 9 — P Normal T↑ C Normal (sobreaquecimento do vapor)
 *  GRUPO 10 — Situação contraditória (erro de instrumentação)
 *
 *  Cada regra verifica problema == null para garantir que
 *  apenas a primeira causa identificada prevalece (FCFS).
 * ============================================================
 */


// ════════════════════════════════════════════════════════════
//  GRUPO 1 — Pressão ↓  Temperatura ↓  Caudal ↓
//  Interpretação: Produção global insuficiente
// ════════════════════════════════════════════════════════════

rule "V-1.1 — Produção Insuficiente por Combustão Anormal"
    salience 90
    when
        $v : SistemaVapor(pressao == "Baixa", temperatura == "Baixa", caudal == "Baixo",
                          combustaoNormal == "Nao")
        $d : Diagnostico(problema == null)
    then
        $d.setTipoAnomalia("Anomalia na Produção de Vapor");
        $d.setProblema("ProducaoInsuficientePorCombustao");
        $d.setEstadoDiagnostico("Concluido");
        $d.setConclusao("Produção de vapor globalmente insuficiente (P↓ T↓ C↓) causada por combustão anormal. " +
                        "Ação: verificar queimadores, disponibilidade de gás e sistema de ignição.");
        $d.addRegraAtivada("V-1.1",
                "Pressão, temperatura e caudal baixos com combustão não normal → causa raiz no sistema de combustão.");
        update($d);
end

rule "V-1.2 — Produção Insuficiente por Turbina sem Calor Suficiente"
    salience 85
    when
        $v : SistemaVapor(pressao == "Baixa", temperatura == "Baixa", caudal == "Baixo",
                          combustaoNormal == "Sim", turbinaForneceCalorSuficiente == "Nao")
        $d : Diagnostico(problema == null)
    then
        $d.setTipoAnomalia("Anomalia na Produção de Vapor");
        $d.setProblema("ProducaoInsuficientePorTurbina");
        $d.setEstadoDiagnostico("Concluido");
        $d.setConclusao("Produção de vapor insuficiente apesar da combustão normal. A turbina não fornece calor suficiente. " +
                        "Ação: verificar carga e eficiência do turbogerador.");
        $d.addRegraAtivada("V-1.2",
                "P↓ T↓ C↓, combustão OK mas turbina sem calor suficiente → falha no turbogerador.");
        update($d);
end

rule "V-1.3 — Produção Insuficiente por Falha no BFW"
    salience 80
    when
        $v : SistemaVapor(pressao == "Baixa", temperatura == "Baixa", caudal == "Baixo",
                          combustaoNormal == "Sim", turbinaForneceCalorSuficiente == "Sim",
                          alimentacaoBFWCorreta == "Nao")
        $d : Diagnostico(problema == null)
    then
        $d.setTipoAnomalia("Anomalia na Produção de Vapor");
        $d.setProblema("ProducaoInsuficientePorBFW");
        $d.setEstadoDiagnostico("Concluido");
        $d.setConclusao("Produção de vapor insuficiente com combustão e turbina OK. Falha na alimentação de água à caldeira (BFW). " +
                        "Ação: verificar bombas BFW, válvulas de alimentação e nível de água no desaerador.");
        $d.addRegraAtivada("V-1.3",
                "P↓ T↓ C↓, combustão e turbina OK, mas BFW com alimentação incorreta.");
        update($d);
end

rule "V-1.4 — Produção Insuficiente por Nível do Barrilete Fora dos Limites"
    salience 75
    when
        $v : SistemaVapor(pressao == "Baixa", temperatura == "Baixa", caudal == "Baixo",
                          combustaoNormal == "Sim", turbinaForneceCalorSuficiente == "Sim",
                          alimentacaoBFWCorreta == "Sim", nivelBarrileteDentroLimites == "Nao")
        $d : Diagnostico(problema == null)
    then
        $d.setTipoAnomalia("Anomalia na Produção de Vapor");
        $d.setProblema("ProducaoInsuficientePorNivelBarrilete");
        $d.setEstadoDiagnostico("Concluido");
        $d.setConclusao("Produção de vapor insuficiente com BFW OK. Nível do barrilete fora dos limites operacionais. " +
                        "Ação: verificar controlo de nível do barrilete e possíveis fugas internas.");
        $d.addRegraAtivada("V-1.4",
                "P↓ T↓ C↓, combustão/turbina/BFW OK, mas nível do barrilete fora dos limites.");
        update($d);
end

rule "V-1.5 — Produção Insuficiente por Falha no Sistema de Controlo"
    salience 70
    when
        $v : SistemaVapor(pressao == "Baixa", temperatura == "Baixa", caudal == "Baixo",
                          combustaoNormal == "Sim", turbinaForneceCalorSuficiente == "Sim",
                          alimentacaoBFWCorreta == "Sim", nivelBarrileteDentroLimites == "Sim",
                          sistemaControloAtuaCorretamente == "Nao")
        $d : Diagnostico(problema == null)
    then
        $d.setTipoAnomalia("Anomalia na Produção de Vapor");
        $d.setProblema("ProducaoInsuficientePorFalhaControlo");
        $d.setEstadoDiagnostico("Concluido");
        $d.setConclusao("Produção de vapor insuficiente sem causa física identificada. Sistema de controlo a atuar incorretamente. " +
                        "Ação: verificar setpoints, PID e atuadores do sistema de controlo da caldeira.");
        $d.addRegraAtivada("V-1.5",
                "P↓ T↓ C↓, todos os subsistemas OK exceto o sistema de controlo.");
        update($d);
end


// ════════════════════════════════════════════════════════════
//  GRUPO 2 — Pressão ↓  Temperatura ↓  Caudal Normal
//  Interpretação: Energia térmica insuficiente
// ════════════════════════════════════════════════════════════

rule "V-2.1 — Energia Térmica Insuficiente por Combustão Deficiente"
    salience 90
    when
        $v : SistemaVapor(pressao == "Baixa", temperatura == "Baixa", caudal == "Normal",
                          combustaoNormal == "Nao")
        $d : Diagnostico(problema == null)
    then
        $d.setTipoAnomalia("Anomalia na Produção de Vapor");
        $d.setProblema("BaixaPressaoTemperaturaPorCombustaoDeficiente");
        $d.setEstadoDiagnostico("Concluido");
        $d.setConclusao("Pressão e temperatura baixas com caudal normal indicam energia térmica insuficiente por combustão deficiente. " +
                        "Ação: verificar queimadores, relação ar/combustível e caudal de gás.");
        $d.addRegraAtivada("V-2.1",
                "P↓ T↓ C Normal → energia térmica insuficiente com combustão anormal.");
        update($d);
end

rule "V-2.2 — Energia Térmica Insuficiente por Turbina"
    salience 85
    when
        $v : SistemaVapor(pressao == "Baixa", temperatura == "Baixa", caudal == "Normal",
                          combustaoNormal == "Sim", turbinaForneceCalorSuficiente == "Nao")
        $d : Diagnostico(problema == null)
    then
        $d.setTipoAnomalia("Anomalia na Produção de Vapor");
        $d.setProblema("BaixaPressaoTemperaturaPorInsuficienciaTurbina");
        $d.setEstadoDiagnostico("Concluido");
        $d.setConclusao("Pressão e temperatura baixas com caudal normal e combustão OK. Turbina não fornece calor suficiente à caldeira. " +
                        "Ação: verificar carga da turbina e temperatura dos gases de escape.");
        $d.addRegraAtivada("V-2.2",
                "P↓ T↓ C Normal, combustão OK mas turbina insuficiente → problema no turbogerador.");
        update($d);
end

rule "V-2.3 — Temperatura Baixa por Arrefecimento Excessivo no Dessobreaquecedor"
    salience 80
    when
        $v : SistemaVapor(pressao == "Baixa", temperatura == "Baixa", caudal == "Normal",
                          combustaoNormal == "Sim", turbinaForneceCalorSuficiente == "Sim",
                          dessobreaquecedorAbertoEmExcesso == "Sim")
        $d : Diagnostico(problema == null)
    then
        $d.setTipoAnomalia("Anomalia na Produção de Vapor");
        $d.setProblema("TemperaturaBaixaPorArrefecimentoExcessivo");
        $d.setEstadoDiagnostico("Concluido");
        $d.setConclusao("Temperatura baixa causada pelo dessobreaquecedor aberto em excesso, provocando arrefecimento excessivo do vapor. " +
                        "Ação: reduzir abertura do dessobreaquecedor e verificar setpoint de temperatura.");
        $d.addRegraAtivada("V-2.3",
                "P↓ T↓ C Normal, combustão e turbina OK, dessobreaquecedor aberto em excesso.");
        update($d);
end

rule "V-2.4 — Erro de Instrumentação (sensores incoerentes, P↓ T↓ C Normal)"
    salience 60
    when
        $v : SistemaVapor(pressao == "Baixa", temperatura == "Baixa", caudal == "Normal",
                          sensoresCoerentes == "Nao")
        $d : Diagnostico(problema == null)
    then
        $d.setTipoAnomalia("Anomalia na Produção de Vapor");
        $d.setProblema("ErroInstrumentacao");
        $d.setEstadoDiagnostico("Concluido");
        $d.setConclusao("Leituras de pressão e temperatura baixas com caudal normal mas sensores incoerentes. Possível falha de instrumentação. " +
                        "Ação: verificar calibração e integridade dos transmissores de pressão e temperatura.");
        $d.addRegraAtivada("V-2.4",
                "P↓ T↓ C Normal com sensores incoerentes → suspeita de erro de instrumentação.");
        update($d);
end


// ════════════════════════════════════════════════════════════
//  GRUPO 3 — Pressão ↓  Temperatura Normal  Caudal ↓
//  Interpretação: Produção parcial insuficiente ou restrição
// ════════════════════════════════════════════════════════════

rule "V-3.1 — Baixo Caudal e Pressão por Válvula de Saída Fechada"
    salience 90
    when
        $v : SistemaVapor(pressao == "Baixa", temperatura == "Normal", caudal == "Baixo",
                          valvulasVaporTotalmenteAbertas == "Nao")
        $d : Diagnostico(problema == null)
    then
        $d.setTipoAnomalia("Anomalia na Produção de Vapor");
        $d.setProblema("BaixoCaudalPressaoPorValvulaFechada");
        $d.setEstadoDiagnostico("Concluido");
        $d.setConclusao("Pressão e caudal baixos com temperatura normal. Válvula(s) de saída de vapor não totalmente abertas. " +
                        "Ação: verificar posição e atuador das válvulas de saída da caldeira.");
        $d.addRegraAtivada("V-3.1",
                "P↓ T Normal C↓, válvulas de vapor não totalmente abertas → restrição mecânica.");
        update($d);
end

rule "V-3.2 — Baixo Caudal e Pressão por Restrição na Linha de Vapor"
    salience 85
    when
        $v : SistemaVapor(pressao == "Baixa", temperatura == "Normal", caudal == "Baixo",
                          valvulasVaporTotalmenteAbertas == "Sim", restricaoLinhaVapor == "Sim")
        $d : Diagnostico(problema == null)
    then
        $d.setTipoAnomalia("Anomalia na Produção de Vapor");
        $d.setProblema("BaixoCaudalPressaoPorRestricaoLinha");
        $d.setEstadoDiagnostico("Concluido");
        $d.setConclusao("Restrição detetada na linha de distribuição de vapor com válvulas abertas. " +
                        "Ação: inspecionar linha de vapor para depósitos, corpos estranhos ou válvulas parcialmente fechadas.");
        $d.addRegraAtivada("V-3.2",
                "P↓ T Normal C↓, válvulas abertas mas restrição detetada na linha de vapor.");
        update($d);
end

rule "V-3.3 — Baixo Caudal e Pressão por Produção Insuficiente"
    salience 80
    when
        $v : SistemaVapor(pressao == "Baixa", temperatura == "Normal", caudal == "Baixo",
                          valvulasVaporTotalmenteAbertas == "Sim", restricaoLinhaVapor == "Nao",
                          combustaoNormal == "Nao")
        $d : Diagnostico(problema == null)
    then
        $d.setTipoAnomalia("Anomalia na Produção de Vapor");
        $d.setProblema("BaixoCaudalPressaoPorProducaoInsuficiente");
        $d.setEstadoDiagnostico("Concluido");
        $d.setConclusao("Caudal e pressão baixos sem restrições físicas na linha. A produção é insuficiente por combustão deficiente. " +
                        "Ação: aumentar carga de combustão e verificar o estado dos queimadores.");
        $d.addRegraAtivada("V-3.3",
                "P↓ T Normal C↓, sem restrições na linha mas combustão anormal.");
        update($d);
end

rule "V-3.4 — Erro no Medidor de Caudal (P↓ T Normal C↓)"
    salience 60
    when
        $v : SistemaVapor(pressao == "Baixa", temperatura == "Normal", caudal == "Baixo",
                          medidorCaudalCorreto == "Nao")
        $d : Diagnostico(problema == null)
    then
        $d.setTipoAnomalia("Anomalia na Produção de Vapor");
        $d.setProblema("ErroInstrumentacaoCaudal");
        $d.setEstadoDiagnostico("Concluido");
        $d.setConclusao("Leitura de caudal baixa possivelmente incorreta. Medidor de caudal com falha. " +
                        "Ação: verificar calibração, obstruções no elemento primário e integridade do transmissor de caudal.");
        $d.addRegraAtivada("V-3.4",
                "P↓ T Normal C↓ com medidor de caudal com falha → suspeita de erro de instrumentação.");
        update($d);
end


// ════════════════════════════════════════════════════════════
//  GRUPO 4 — Pressão ↓  Temperatura Normal  Caudal Normal
//  Interpretação: Perda de pressão
// ════════════════════════════════════════════════════════════

rule "V-4.1 — Perda de Pressão por Válvula Aberta Indevidamente"
    salience 90
    when
        $v : SistemaVapor(pressao == "Baixa", temperatura == "Normal", caudal == "Normal",
                          valvulaAbertaIndevidamente == "Sim")
        $d : Diagnostico(problema == null)
    then
        $d.setTipoAnomalia("Anomalia na Produção de Vapor");
        $d.setProblema("PerdaPressaoPorValvulaAbertaIndevidamente");
        $d.setEstadoDiagnostico("Concluido");
        $d.setConclusao("Queda de pressão com caudal e temperatura normais. Válvula aberta indevidamente a drenar pressão. " +
                        "Ação: identificar e fechar a válvula aberta de forma indevida.");
        $d.addRegraAtivada("V-4.1",
                "P↓ T Normal C Normal com válvula aberta indevidamente → fuga de pressão.");
        update($d);
end

rule "V-4.2 — Perda de Pressão por Fuga na Linha de Vapor"
    salience 85
    when
        $v : SistemaVapor(pressao == "Baixa", temperatura == "Normal", caudal == "Normal",
                          valvulaAbertaIndevidamente == "Nao", fugaLinhaVapor == "Sim")
        $d : Diagnostico(problema == null)
    then
        $d.setTipoAnomalia("Anomalia na Produção de Vapor");
        $d.setProblema("PerdaPressaoPorFugaLinha");
        $d.setEstadoDiagnostico("Concluido");
        $d.setConclusao("Queda de pressão com fuga confirmada na linha de vapor. " +
                        "Ação: localizar e isolar o ponto de fuga. Verificar juntas, flanges e válvulas de purga.");
        $d.addRegraAtivada("V-4.2",
                "P↓ T Normal C Normal, sem válvula indevida, mas fuga confirmada na linha.");
        update($d);
end

rule "V-4.3 — Queda de Pressão por Aumento de Consumo"
    salience 80
    when
        $v : SistemaVapor(pressao == "Baixa", temperatura == "Normal", caudal == "Normal",
                          valvulaAbertaIndevidamente == "Nao", fugaLinhaVapor == "Nao",
                          consumoVapor == "Aumentou")
        $d : Diagnostico(problema == null)
    then
        $d.setTipoAnomalia("Anomalia na Produção de Vapor");
        $d.setProblema("QuedaPressaoPorAumentoConsumo");
        $d.setEstadoDiagnostico("Concluido");
        $d.setConclusao("Queda de pressão causada por aumento súbito do consumo de vapor no processo. " +
                        "Ação: aumentar a produção de vapor ou reduzir a carga nos consumidores.");
        $d.addRegraAtivada("V-4.3",
                "P↓ T Normal C Normal, sem fugas/válvulas, consumo de vapor aumentado.");
        update($d);
end

rule "V-4.4 — Erro no Sensor de Pressão (P↓ T Normal C Normal)"
    salience 60
    when
        $v : SistemaVapor(pressao == "Baixa", temperatura == "Normal", caudal == "Normal",
                          sensorPressaoCorreto == "Nao")
        $d : Diagnostico(problema == null)
    then
        $d.setTipoAnomalia("Anomalia na Produção de Vapor");
        $d.setProblema("ErroInstrumentacaoPressao");
        $d.setEstadoDiagnostico("Concluido");
        $d.setConclusao("Leitura de pressão baixa com temperatura e caudal normais. Sensor de pressão provavelmente com falha. " +
                        "Ação: verificar sensor de pressão, tubagem de impulso e transmissor.");
        $d.addRegraAtivada("V-4.4",
                "P↓ T Normal C Normal com sensor de pressão com falha → erro de instrumentação.");
        update($d);
end


// ════════════════════════════════════════════════════════════
//  GRUPO 5 — Pressão Normal  Temperatura ↓  Caudal Normal
//  Interpretação: Problema térmico localizado
// ════════════════════════════════════════════════════════════

rule "V-5.1 — Temperatura Baixa por Combustão Insuficiente"
    salience 90
    when
        $v : SistemaVapor(pressao == "Normal", temperatura == "Baixa", caudal == "Normal",
                          combustaoNormal == "Nao")
        $d : Diagnostico(problema == null)
    then
        $d.setTipoAnomalia("Anomalia na Produção de Vapor");
        $d.setProblema("TemperaturaBaixaPorCombustaoInsuficiente");
        $d.setEstadoDiagnostico("Concluido");
        $d.setConclusao("Temperatura do vapor baixa com pressão e caudal normais. Combustão insuficiente é a causa do défice térmico. " +
                        "Ação: verificar queimadores, caudal de gás e relação ar/combustível.");
        $d.addRegraAtivada("V-5.1",
                "P Normal T↓ C Normal com combustão anormal → défice térmico por combustão.");
        update($d);
end

rule "V-5.2 — Temperatura Baixa por Baixa Carga da Turbina"
    salience 85
    when
        $v : SistemaVapor(pressao == "Normal", temperatura == "Baixa", caudal == "Normal",
                          combustaoNormal == "Sim", turbinaForneceCalorSuficiente == "Nao")
        $d : Diagnostico(problema == null)
    then
        $d.setTipoAnomalia("Anomalia na Produção de Vapor");
        $d.setProblema("TemperaturaBaixaPorBaixaCargaTurbina");
        $d.setEstadoDiagnostico("Concluido");
        $d.setConclusao("Temperatura baixa com pressão e caudal normais e combustão OK. A turbina não fornece calor suficiente. " +
                        "Ação: verificar carga elétrica do turbogerador e temperatura dos gases de escape.");
        $d.addRegraAtivada("V-5.2",
                "P Normal T↓ C Normal, combustão OK mas turbina não fornece calor suficiente.");
        update($d);
end

rule "V-5.3 — Temperatura Baixa por Dessobreaquecedor Aberto em Excesso"
    salience 80
    when
        $v : SistemaVapor(pressao == "Normal", temperatura == "Baixa", caudal == "Normal",
                          dessobreaquecedorAbertoEmExcesso == "Sim")
        $d : Diagnostico(problema == null)
    then
        $d.setTipoAnomalia("Anomalia na Produção de Vapor");
        $d.setProblema("TemperaturaBaixaPorDessobreaquecedor");
        $d.setEstadoDiagnostico("Concluido");
        $d.setConclusao("Temperatura do vapor baixa causada pelo dessobreaquecedor aberto em excesso. " +
                        "Ação: reduzir o caudal de água de injeção no dessobreaquecedor e verificar controlador de temperatura.");
        $d.addRegraAtivada("V-5.3",
                "P Normal T↓ C Normal com dessobreaquecedor aberto em excesso → arrefecimento excessivo.");
        update($d);
end

rule "V-5.4 — Erro no Sensor de Temperatura (P Normal T↓ C Normal)"
    salience 60
    when
        $v : SistemaVapor(pressao == "Normal", temperatura == "Baixa", caudal == "Normal",
                          sensorTemperaturaCorreto == "Nao")
        $d : Diagnostico(problema == null)
    then
        $d.setTipoAnomalia("Anomalia na Produção de Vapor");
        $d.setProblema("ErroInstrumentacaoTemperatura");
        $d.setEstadoDiagnostico("Concluido");
        $d.setConclusao("Leitura de temperatura baixa com pressão e caudal normais. Possível falha no sensor de temperatura. " +
                        "Ação: verificar termopar/RTD e transmissor de temperatura.");
        $d.addRegraAtivada("V-5.4",
                "P Normal T↓ C Normal com sensor de temperatura com falha → erro de instrumentação.");
        update($d);
end


// ════════════════════════════════════════════════════════════
//  GRUPO 6 — Pressão Normal  Temperatura Normal  Caudal ↓
//  Interpretação: Caudal insuficiente
// ════════════════════════════════════════════════════════════

rule "V-6.1 — Caudal Baixo por Válvula de Saída Fechada"
    salience 90
    when
        $v : SistemaVapor(pressao == "Normal", temperatura == "Normal", caudal == "Baixo",
                          valvulasVaporTotalmenteAbertas == "Nao")
        $d : Diagnostico(problema == null)
    then
        $d.setTipoAnomalia("Anomalia na Produção de Vapor");
        $d.setProblema("CaudalBaixoPorValvulaSaidaFechada");
        $d.setEstadoDiagnostico("Concluido");
        $d.setConclusao("Caudal de vapor baixo com pressão e temperatura normais. Válvula(s) de saída não totalmente abertas. " +
                        "Ação: verificar posição e atuador das válvulas de saída.");
        $d.addRegraAtivada("V-6.1",
                "P Normal T Normal C↓ com válvulas de vapor não totalmente abertas.");
        update($d);
end

rule "V-6.2 — Caudal Baixo por Restrição na Linha de Distribuição"
    salience 85
    when
        $v : SistemaVapor(pressao == "Normal", temperatura == "Normal", caudal == "Baixo",
                          valvulasVaporTotalmenteAbertas == "Sim", restricaoLinhaVapor == "Sim")
        $d : Diagnostico(problema == null)
    then
        $d.setTipoAnomalia("Anomalia na Produção de Vapor");
        $d.setProblema("CaudalBaixoPorRestricaoLinha");
        $d.setEstadoDiagnostico("Concluido");
        $d.setConclusao("Caudal baixo com pressão e temperatura normais e válvulas abertas. Restrição na linha de distribuição. " +
                        "Ação: inspecionar linha para depósitos ou obstruções, verificar filtros e purgadores.");
        $d.addRegraAtivada("V-6.2",
                "P Normal T Normal C↓, válvulas abertas mas restrição na linha.");
        update($d);
end

rule "V-6.3 — Caudal Baixo por Redução da Procura de Vapor"
    salience 80
    when
        $v : SistemaVapor(pressao == "Normal", temperatura == "Normal", caudal == "Baixo",
                          consumoVapor == "Diminuiu")
        $d : Diagnostico(problema == null)
    then
        $d.setTipoAnomalia("Anomalia na Produção de Vapor");
        $d.setProblema("CaudalBaixoPorReducaoProcura");
        $d.setEstadoDiagnostico("Concluido");
        $d.setConclusao("Caudal de vapor baixo com pressão e temperatura normais. Redução da procura no processo. " +
                        "Ação: confirmar com os utilizadores de vapor se existe redução de carga prevista. Situação normal se intencional.");
        $d.addRegraAtivada("V-6.3",
                "P Normal T Normal C↓ com consumo de vapor diminuído → redução da procura.");
        update($d);
end

rule "V-6.4 — Erro no Medidor de Caudal (P Normal T Normal C↓)"
    salience 60
    when
        $v : SistemaVapor(pressao == "Normal", temperatura == "Normal", caudal == "Baixo",
                          medidorCaudalCorreto == "Nao")
        $d : Diagnostico(problema == null)
    then
        $d.setTipoAnomalia("Anomalia na Produção de Vapor");
        $d.setProblema("ErroInstrumentacaoCaudal");
        $d.setEstadoDiagnostico("Concluido");
        $d.setConclusao("Leitura de caudal baixa com pressão e temperatura normais. Possível falha no medidor de caudal. " +
                        "Ação: verificar medidor de caudal, placa de orifício e transmissor diferencial.");
        $d.addRegraAtivada("V-6.4",
                "P Normal T Normal C↓ com medidor de caudal com falha → erro de instrumentação.");
        update($d);
end


// ════════════════════════════════════════════════════════════
//  GRUPO 7 — Pressão ↑  Temperatura ↑
//  Interpretação: Produção excessiva / sobreaquecimento
// ════════════════════════════════════════════════════════════

rule "V-7.1 — Produção Excessiva por Combustão Excessiva"
    salience 90
    when
        $v : SistemaVapor(pressao == "Alta", temperatura == "Alta", caudal == "Alto",
                          combustaoNormal == "Nao")
        $d : Diagnostico(problema == null)
    then
        $d.setTipoAnomalia("Anomalia na Produção de Vapor");
        $d.setProblema("ProducaoExcessivaPorCombustao");
        $d.setEstadoDiagnostico("Concluido");
        $d.setConclusao("Produção de vapor excessiva (P↑ T↑ C↑) causada por combustão excessiva. " +
                        "Ação: reduzir caudal de gás, verificar controlador de combustão e válvula de controlo de gás.");
        $d.addRegraAtivada("V-7.1",
                "P↑ T↑ C↑ com combustão anormal → produção excessiva por excesso de combustão.");
        update($d);
end

rule "V-7.2 — Pressão e Temperatura Altas por Redução do Consumo"
    salience 85
    when
        $v : SistemaVapor(pressao == "Alta", temperatura == "Alta", caudal == "Normal",
                          consumoVapor == "Diminuiu")
        $d : Diagnostico(problema == null)
    then
        $d.setTipoAnomalia("Anomalia na Produção de Vapor");
        $d.setProblema("PressaoAltaPorReducaoConsumo");
        $d.setEstadoDiagnostico("Concluido");
        $d.setConclusao("Pressão e temperatura altas por redução súbita do consumo de vapor no processo. " +
                        "Ação: reduzir produção de vapor ou abrir válvula de alívio de pressão.");
        $d.addRegraAtivada("V-7.2",
                "P↑ T↑ C Normal com consumo de vapor reduzido.");
        update($d);
end

rule "V-7.3 — Sobreaquecimento por Falha no Sistema de Controlo"
    salience 80
    when
        $v : SistemaVapor(pressao == "Alta", temperatura == "Alta",
                          sistemaControloAtuaCorretamente == "Nao")
        $d : Diagnostico(problema == null)
    then
        $d.setTipoAnomalia("Anomalia na Produção de Vapor");
        $d.setProblema("SobreproducaoPorFalhaControlo");
        $d.setEstadoDiagnostico("Concluido");
        $d.setConclusao("Pressão e temperatura excessivas com sistema de controlo com falha. " +
                        "Ação: verificar controladores de pressão e temperatura, forçar modo manual se necessário.");
        $d.addRegraAtivada("V-7.3",
                "P↑ T↑ com sistema de controlo com falha → sobreaquecimento por perda de controlo.");
        update($d);
end

rule "V-7.4 — Erro de Instrumentação (P↑ T↑ — sensores incoerentes)"
    salience 60
    when
        $v : SistemaVapor(pressao == "Alta", temperatura == "Alta",
                          sensoresCoerentes == "Nao")
        $d : Diagnostico(problema == null)
    then
        $d.setTipoAnomalia("Anomalia na Produção de Vapor");
        $d.setProblema("ErroInstrumentacao");
        $d.setEstadoDiagnostico("Concluido");
        $d.setConclusao("Leituras de pressão e temperatura altas com sensores incoerentes entre si. Possível falha de instrumentação. " +
                        "Ação: verificar calibração cruzada de sensores e comparar com leituras redundantes.");
        $d.addRegraAtivada("V-7.4",
                "P↑ T↑ com sensores incoerentes → possível erro de instrumentação.");
        update($d);
end


// ════════════════════════════════════════════════════════════
//  GRUPO 8 — Pressão ↑  Temperatura Normal
//  Interpretação: Acumulação de pressão
// ════════════════════════════════════════════════════════════

rule "V-8.1 — Acumulação de Pressão por Baixo Consumo"
    salience 90
    when
        $v : SistemaVapor(pressao == "Alta", temperatura == "Normal",
                          consumoVapor == "Baixo")
        $d : Diagnostico(problema == null)
    then
        $d.setTipoAnomalia("Anomalia na Produção de Vapor");
        $d.setProblema("AcumulacaoPressaoPorBaixoConsumo");
        $d.setEstadoDiagnostico("Concluido");
        $d.setConclusao("Acumulação de pressão com temperatura normal por consumo de vapor muito baixo. " +
                        "Ação: reduzir produção de vapor ou verificar consumidores de processo.");
        $d.addRegraAtivada("V-8.1",
                "P↑ T Normal com consumo de vapor baixo → acumulação por desequilíbrio produção/consumo.");
        update($d);
end

rule "V-8.2 — Acumulação de Pressão por Restrição na Saída"
    salience 85
    when

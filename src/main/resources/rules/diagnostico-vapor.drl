// ── Grupo 8 fallback ─────────────────────────────────────────
rule "V-8.5 — Pressão Acumulada por Condição Operacional Não Identificada"
    salience 45
    when
        $v : SistemaVapor(pressao == "Alta", temperatura == "Normal",
                          sensorPressaoCorreto == "Sim",
                          controloPressaoAtuaCorretamente == "Sim",
                          valvulasVaporTotalmenteAbertas == "Sim",
                          consumoVapor == "Normal")
        $d : Diagnostico(problema == null)
    then
        $d.setTipoAnomalia("Anomalia na Produção de Vapor");
        $d.setProblema("PressaoAcumuladaNaoCausaIdentificada");
        $d.setEstadoDiagnostico("Concluido");
        $d.setConclusao("Pressão alta com temperatura normal e todos os sistemas de controlo OK. " +
                        "Causa da acumulação de pressão não identificada automaticamente. " +
                        "Necessita verificação manual: inspecionar válvulas de alívio, " +
                        "confirmar condições de consumo a jusante e estado da rede.");
        $d.addRegraAtivada("V-8.5",
                "P↑ T Normal com controlo e sensores OK → pressão acumulada por condição operacional não identificada.");
        update($d);
end

// ── Grupo 9 fallback ─────────────────────────────────────────
rule "V-9.5 — Falha no Controlo Térmico da Caldeira"
    salience 45
    when
        $v : SistemaVapor(pressao == "Normal", temperatura == "Alta", caudal == "Normal",
                          sensorTemperaturaCorreto == "Sim",
                          dessobreaquecedorAtuaCorretamente == "Sim",
                          combustaoNormal == "Sim",
                          turbinaForneceCalorSuficiente == "Nao")
        $d : Diagnostico(problema == null)
    then
        $d.setTipoAnomalia("Anomalia na Produção de Vapor");
        $d.setProblema("FalhaControloTermicoCaldeira");
        $d.setEstadoDiagnostico("Concluido");
        $d.setConclusao("Temperatura alta com pressão e caudal normais, dessobreaquecedor OK e combustão normal. " +
                        "A turbina não tem carga elevada — a causa é uma falha no controlo térmico da caldeira. " +
                        "Ação: verificar controlador de temperatura, sensor de setpoint " +
                        "e válvula de regulação do dessobreaquecedor.");
        $d.addRegraAtivada("V-9.5",
                "P Normal T↑ C Normal, combustão OK, dessobreaquecedor OK, turbina sem carga elevada → falha no controlo térmico.");
        update($d);
end

// ── Grupo 11 — P Normal T Normal C Alto ──────────────────────
rule "V-11.1 — Caudal de Vapor Excessivo"
    salience 60
    when
        $v : SistemaVapor(pressao == "Normal", temperatura == "Normal", caudal == "Alto")
        $d : Diagnostico(problema == null)
    then
        $d.setTipoAnomalia("Anomalia na Produção de Vapor");
        $d.setProblema("CaudalExcessivoVapor");
        $d.setEstadoDiagnostico("Concluido");
        $d.setConclusao("Caudal de vapor excessivo com pressão e temperatura normais. " +
                        "Indica aumento anormal do consumo de vapor no processo ou by-pass indevidamente aberto. " +
                        "Ação: verificar consumidores de vapor, estado das válvulas de by-pass " +
                        "e traps de vapor em falha aberta.");
        $d.addRegraAtivada("V-11.1",
                "P Normal T Normal C↑ → caudal excessivo por aumento de consumo ou by-pass aberto.");
        update($d);
end

// ── Grupo 12 — Nominal Operation ──────────────────────────────
rule "V-12.1 — Funcionamento Nominal do Sistema de Vapor"
    salience 60
    when
        $v : SistemaVapor(pressao == "Normal", temperatura == "Normal", caudal == "Normal")
        $d : Diagnostico(problema == null)
    then
        $d.setTipoAnomalia("Anomalia na Produção de Vapor");
        $d.setProblema("FuncionamentoNominal");
        $d.setEstadoDiagnostico("Concluido");
        $d.setConclusao("O sistema de produção de vapor está a funcionar dentro dos parâmetros nominais. " +
                        "Não foram detetadas anomalias ativas pelo motor de diagnóstico.");
        $d.addRegraAtivada("V-12.1",
                "Pressão, temperatura e caudal normais → funcionamento nominal.");
        update($d);
end

// ── Fallback Geral do Vapor ──────────────────────────────────
rule "V-99.1 — Diagnóstico de Vapor Inconclusivo (Verificação Manual)"
    salience 1
    when
        $d : Diagnostico(problema == null)
    then
        $d.setTipoAnomalia("Anomalia na Produção de Vapor");
        $d.setProblema("DiagnosticoVaporInconclusivo");
        $d.setEstadoDiagnostico("Concluido");
        $d.setConclusao("Não foi possível identificar uma causa específica para a anomalia reportada. " +
                        "Os sintomas indicam um desvio dos parâmetros nominais, mas os checks automáticos foram inconclusivos. " +
                        "Ação: realizar uma inspeção manual completa ao sistema de vapor e à instrumentação.");
        $d.addRegraAtivada("V-99.1",
                "Sintomas presentes mas nenhum diagnóstico específico ativado → verificação manual necessária.");
        update($d);
end


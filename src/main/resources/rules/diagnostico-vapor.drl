                        "Ação: verificar sensor de pressão, comparar com manómetro local redundante.");
        $d.addRegraAtivada("V-8.4",
                "P↑ T Normal com sensor de pressão com falha → possível leitura falsa.");
        update($d);
end


// ════════════════════════════════════════════════════════════
//  GRUPO 9 — Pressão Normal  Temperatura ↑  Caudal Normal
//  Interpretação: Sobreaquecimento do vapor
// ════════════════════════════════════════════════════════════

rule "V-9.1 — Sobreaquecimento por Falha no Dessobreaquecedor"
    salience 90
    when
        $v : SistemaVapor(pressao == "Normal", temperatura == "Alta", caudal == "Normal",
                          dessobreaquecedorAtuaCorretamente == "Nao")
        $d : Diagnostico(problema == null)
